# juicer production env — copy to ~/projects/apps/juicer/.env on app VM

# PostgreSQL
POSTGRES_DB=juicer_db
POSTGRES_USER=juicer_postgres_user
POSTGRES_PASSWORD=<change-me>
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Discord OAuth
DISCORD_BOT_TOKEN=<discord-bot-token>
VITE_CLIENT_ID=<discord-client-id>
CLIENT_SECRET=<discord-client-secret>
VITE_API_ENDPOINT=https://discord.com/api/v10

# OAuth Redirects (production)
REDIRECT_URI=https://juicer.kuukan.dev/backend/discord/auth/callback
REDIRECT_AFTER_SIGN_IN_URI=https://juicer.kuukan.dev/
REDIRECT_AFTER_SIGN_IN_FAILED_URI=https://juicer.kuukan.dev/sign-in-failed

# App
ENVIRONMENT=production
ALLOWED_ORIGINS=https://juicer.kuukan.dev
