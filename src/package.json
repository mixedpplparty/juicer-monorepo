{
	"name": "juicer",
	"version": "0.0.1",
	"description": "",
	"scripts": {
		"dev:client": "cd client && pnpm run dev",
		"dev:server": "cargo run --manifest-path server-rust/Cargo.toml --locked",
		"db:migrate": "cargo run --manifest-path server-rust/Cargo.toml --locked -- migrate",
		"dev:shared": "cd shared && pnpm run dev",
		"dev": "concurrently \"pnpm run dev:shared\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
		"build:client": "cd client && pnpm run build",
		"build:shared": "cd shared && pnpm run build",
		"build:server": "cargo build --manifest-path server-rust/Cargo.toml --locked --release",
		"build": "pnpm run build:shared && pnpm run build:server && pnpm run build:client",
		"postinstall": "pnpm run build:shared"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"concurrently": "^9.2.1"
	},
	"keywords": [],
	"author": "MareNectaris",
	"license": "ISC",
	"packageManager": "pnpm@10.12.1"
}
